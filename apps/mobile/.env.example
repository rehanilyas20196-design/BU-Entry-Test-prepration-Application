# Supabase (client-safe anon key only)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# API base URL
EXPO_PUBLIC_API_URL=http://localhost:4000

# Disable API access in dev if not set
EXPO_PUBLIC_APP_NAME=BUET Prep AI

# Direct APK download URL (used by the website download banner).
# MUST point directly at the .apk FILE (e.g. a GitHub release asset), NOT a
# build page. GitHub release assets download directly; EAS/expo.dev build
# pages install via Expo Go and should not be used here.
EXPO_PUBLIC_APK_URL=https://github.com/rehanilyas20196-design/BU-APPLICATION-APK-FILES/releases/download/v1.0.0/BU-ENTRY-TEST.apk

