# BUET Prep AI API — environment configuration
# Copy to .env and fill in real values. NEVER commit .env.

# --- Server ---
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Database direct connection (used for migrations/tools only)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Auth ---
# JWT secret used to validate/issue access tokens. Use a long random string in prod.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# --- AI (server-side only, NEVER shipped to the client) ---
AI_PROVIDER=openai
AI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
AI_MAX_INPUT_LENGTH=4000
AI_MAX_OUTPUT_LENGTH=3000

# Optional second provider for abstraction testing
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100
