{
  "name": "buet-prep-ai",
  "version": "0.1.0",
  "private": true,
  "description": "BUET Prep AI - Independent BUET preparation platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "npm run start:dev --workspace @buet-prep/api",
    "api:build": "npm run build --workspace @buet-prep/api",
    "api:test": "npm run test --workspace @buet-prep/api",
    "api:lint": "npm run lint --workspace @buet-prep/api",
    "mobile:start": "npm run start --workspace @buet-prep/mobile",
    "mobile:android": "npm run android --workspace @buet-prep/mobile",
    "mobile:ios": "npm run ios --workspace @buet-prep/mobile",
    "mobile:typecheck": "npm run typecheck --workspace @buet-prep/mobile",
    "admin:dev": "npm run dev --workspace @buet-prep/admin",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react": "19.1.0",
    "react-native": "0.81.5"
  }
}
